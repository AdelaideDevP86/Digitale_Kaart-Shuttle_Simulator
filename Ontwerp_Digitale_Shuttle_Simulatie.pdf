    ],
    [
      "REQ14",
      "Versies en configuratie",
      "Kaart, contract, software, board, pinnen en kalibratie zijn identificeerbaar en controleerbaar."
    ],
    [
      "REQ15",
      "Aantoonbaar succes",
      "Alle gevraagde bezoeken, servicebeleid en eindpunt bevestigd voor een positief resultaat."
    ],
    [
      "REQ16",
      "Beveiligde toegang",
      "Broker-ACL, autorisatie, geheimen buiten broncode en gecontroleerde hardware-activering."
