      "Doorrit zonder meetstop",
      "Alle stappen van vier-attractierit met dwell=0; registreer alle set_motors-aanroepen.",
      "Geen gepland (0,0) tussen START en END; nood-/obstakelstop apart geclassificeerd.",
      "simulation"
    ],
    [
      "T19",
      "Geldige START",
      "Stuur volledige envelope plus plan met correcte sessie, hash, kaart en beginanker.",
      "RECEIVED, ACCEPTED, APPLIED in juiste volgorde; robot uitvoerder actief.",
      "MQTT integration"
    ],
    [
      "T20",
      "Contract-/versiefouten",
      "Fixtures: onbekende enum, ongeldige range, extra veld, hashfout, kaartmismatch en verlopen opdracht.",
      "REJECTED met veld/foutcode; actieve missie en motorsituatie blijven consistent.",
      "integration"
    ],
    [
      "T21",
      "Dubbele START",
      "Publiceer 10x hetzelfde command_id met QoS1/retry. Herhaal ook dezelfde HTTP Idempotency-Key voor/na serverrestart.",
      "Een missie-installatie; zelfde key/body geeft dezelfde missie, andere body met dezelfde key een conflict.",
      "MQTT + API integration"
    ],
    [
      "T22",
      "Dubbel resultaat",
      "Verlies application-result-ACK; laat agent hetzelfde event_id opnieuw zenden.",
      "UI/server tellen resultaat eenmaal; agent stopt retry na applicatie-ACK.",
      "MQTT integration"
    ],
    [
      "T23",
      "Live status",
      "Start missie en meet send->ACK en status->UI onder afgesproken LAN-belasting.",
      "p95 ACK <=500 ms; snapshot/telemetrie <=1 s aangeboden; source/revisie zichtbaar.",
      "integration"
    ],
    [
      "T24",
      "Wijziging tijdens FOLLOW",
      "REPLACE rev2 op rev1 vanaf volgend anker, zelfde prefix. Variant: geldige rev3 arriveert terwijl rev2 nog pending is.",
      "DEFERRED tot grens; dan hoogste geldige revisie APPLIED. In variant krijgt rev2 SUPERSEDED; geen terugval.",
      "simulation + MQTT"
    ],
    [
      "T25",
      "Wijziging tijdens TURN",
      "Lever rev2 halverwege een draai; laat vervolgens de volgende grens bevestigen.",
      "Huidige manoeuvre blijft intact; wijziging pas daarna atomair toegepast.",
      "simulation"
    ],
    [
      "T26",
      "Oude revisie/ander vertrekpunt",
      "Stuur rev1 na rev2 en rev3 met valid_from_node die niet de afgesproken grens is.",
      "STALE_REVISION of WRONG_BOUNDARY; geen stille herplanning vanaf fictieve positie.",
      "integration"
    ],
    [
      "T27",
      "Annuleren/pauzeren",
      "PAUSE, RESUME en CANCEL op benoemde mission_id; dubbel bezorgen en obstakelclearance tijdens gebruikerspauze.",
      "PAUSED bewaart stap/resume_state; clear heft gebruikerspauze niet op. CANCEL is geen COMPLETED.",
      "simulation"
    ],
    [
      "T28",
      "Offline en retained replay",
      "Verbreek broker tijdens rijden; reconnect met oude retained START en nieuwe sessie.",
      "Alleen geaccepteerd plan volgens offlinebeleid; oude START veroorzaakt geen tweede rit.",
      "MQTT integration"
    ],
    [
      "T29",
      "Reset tijdens missie",
      "Reset na een bevestigd bezoek, voor het volgende punt; herstel lokaal checkpoint en brokerverbinding.",
      "Motoren uit bij boot; pose UNKNOWN; geen automatische fysieke hervatting.",
      "hardware bench"
    ],
    [
      "T30",
      "Kruispunt gemist/dubbel",
      "Laat een breed patroon weg of dupliceer een punt-event; verwachte uitgangen wijken af.",
      "Missie UNCERTAIN; geen fictief anker, geen succes op basis van teller.",
      "fault simulation"
    ],
    [
      "T31",
      "Lijnverlies en herstel",
      "Injecteer 00000 gedurende lange tijd, daarna lijn plus geldig anker; timeoutbeleid=null.",
      "SEARCH blijft beschikbaar; actieve stap niet verbruikt door tijd; nieuwe plannen wachten op anker.",
      "replay"
    ],
    [
      "T32",
      "Vals depotvlak",
      "Injecteer lang zwart vlak bij Wildwater, ook als alle route-instructies verbruikt lijken.",
      "Zonder correct depotanker geen COMPLETED.",
      "fault simulation"
    ],
    [
      "T33",
      "Een bezoek ontbreekt",
      "Simuleer eindanker depot met een ontbrekende service-evidence of onvoltooide dwell.",
      "Geen COMPLETED; reden MISSING_SERVICE of DWELL_INCOMPLETE.",
      "unit"
    ],
    [
      "T34",
      "Correcte afsluiting",
      "Alle bezoeken, dwells en eindanker bevestigd; voer END uit en herbezorg resultaat.",
      "Een unieke completion-event; motoren uit; UI missie afgerond.",
      "integration"
    ],
    [
      "T35",
      "Simbericht op hardware",
      "Stuur een plan/event met source=simulation of sim-topic naar hw-ingang.",
      "ACL/adapter/agent weigeren; 0 fysieke motoropdrachten.",
      "security integration"
    ],
    [
      "T36",
      "Exacte replay",
      "Bewaar volledige ruwe frames, commando's en config; voer tweemaal uit met FakeClock.",
      "Gelijke genormaliseerde eventtrace, stappen en bewijsbesluiten.",
      "replay"
    ],
    [
      "T37",
      "Seeds en snelheidsstress",
      "Drie seeds per synthetisch profiel 0.8/1.0/1.3; identieke map/mission/config.",
      "Elke run reproduceerbaar; afwijkingen zichtbaar als failures/uncertainty, nooit stil succes.",
      "fault simulation"
    ],
    [
      "T38",
      "Lange run en wachtrijen",
      "30 min scenario met hoge telemetrie, disconnects en terugkerende routeopdrachten.",
      "Begrensd geheugengebruik; kritieke events bevestigd of expliciet in degraded toestand.",
      "soak"
    ],
    [
      "T39",
      "Buffers/cache vol",
      "Vul telemetrie, kritieke eventqueue en dedupcache; simuleer trage opslag.",
      "Telemetriecoalescing zichtbaar; geen stil verlies. Nog geldige dedup-records niet evicten; nieuwe opdracht zo nodig afwijzen.",
      "bench"
    ],
    [
      "T40",
      "Browser reconnect/stale data",
      "Sluit WebSocket, sla event_seq over, herlaad pagina en laat snapshot oud worden.",
      "Resync aangevraagd; UI toont stale/UNKNOWN en springt niet naar verzonnen positie.",
      "UI integration"
    ],
    [
      "T41",
      "Onbevoegde opdracht",
      "Client zonder hw-publishrecht probeert START, REPLACE en handmatige ankerbevestiging.",
      "Broker/API weigeren; auditlog zonder wachtwoorden.",
      "security"
    ],
    [
      "T42",
      "TLS/secrets/modes",
      "Ongeldig certificaat, verkeerde brokerconfig, bundle-inspectie en sim/hw-schakeltest.",
      "Verbinding geweigerd bij certificaatfout; geen geheimen in browser/repo/journal.",
      "security"
    ],
    [
      "T43",
      "Servicepunt en pinnen",
      "Meet GPIO/motorpolariteit, vijf sensoren, markers, afstand tot wielas en stationstoppositie.",
      "Ondertekend survey-/kalibratierecord; alleen gemeten servicebeleid vrijgegeven.",
      "hardware commissioning"
    ],
    [
      "T44",
      "Timing op echte ESP32",
      "60 s per belastingsprofiel, met sensortimestamps en motorupdate-markering/meetapparatuur.",
      "p99 <=10 ms, max <=20 ms; board-, firmware- en MQTT-clientversie vastgelegd.",
      "hardware timing"
    ],
    [
      "T45",
      "Voeding/last/bocht",
      "Test gemeten volle/middelste/lagere toegestane voeding en belasting; dezelfde referentiemissies.",
      "Geen gemist doel of vals succes; route- en timingbewijs opgeslagen; geen claim dat PWM snelheid meet.",
      "hardware acceptance"
    ],
    [
      "T46",
      "Verbinding-/stroomherstel",
      "Brokeruitval, wifi-uitval en reset afzonderlijk tijdens service en transit.",
      "Gedrag volgt offlinebeleid; nieuwe sessie vereist; status niet ten onrechte succesvol.",
      "hardware acceptance"
    ],
    [
      "T47",
      "MicroPython-contractpariteit",
      "Importeer gedeelde kern op doelboard; voer golden vectors voor kaart, messages, timerwrap en detector uit.",
      "Zelfde contract-/uitvoerbesluiten als CPython; geen ontbrekende desktopimport.",
      "cross-runtime"
    ],
    [
      "T48",
      "Eindacceptatie en overdracht",
      "Bediener start referentieritten, wijzigt een rit, controleert resultaat en downloadt evidence.",
      "10 correcte opeenvolgende ritten per missie/profiel; handleiding en herstelprocedure uitvoerbaar.",
      "system acceptance"
    ]
  ]
}
endstream
