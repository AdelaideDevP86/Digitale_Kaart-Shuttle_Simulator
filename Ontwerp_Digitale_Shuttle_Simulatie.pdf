    [
      "REQ17",
      "Meetbare kwaliteit",
      "Traceerbare acceptatiecriteria en testorakels voor software, integratie en fysieke baan."
    ],
    [
      "REQ18",
      "Verbindings-/herstartgedrag",
      "Geen dubbele rit na reconnect/reset; vooraf vastgesteld offline- en herstelbeleid."
    ],
    [
      "REQ19",
      "Dynamische verblijftijden",
      "0 ms bij een doorrit of 5000 ms bij een halte; geen verborgen meetstop."
    ],
    [
