    ],
    [
      "REQ08",
      "Geen fictieve positie",
      "Een verwacht punt is geen gemeten uniek punt; onzekerheid en herlokalisatie blijven zichtbaar."
    ],
    [
      "REQ09",
      "Bediening en observatie",
      "Kaart, route, rijrichting, status, revisie en actualiteit zichtbaar zonder brokerwachtwoorden in de browser."
    ],
    [
      "REQ10",
      "Reproduceerbaarheid",
      "Kaart/config/plan/seed en ruwe opnamen maken verschillen terug te vinden en herspeelbaar."
    ],
    [
      "REQ11",
      "Scheiding sim en hardware",
      "Een simulatiebericht kan geen fysieke motoropdracht worden."
    ],
    [
      "REQ12",
      "MicroPython-overdraagbaarheid",
