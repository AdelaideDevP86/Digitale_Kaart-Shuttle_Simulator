        "snapshot: dict"
      ],
      "ops": [
        "apply(event) -> None",
        "resync(snapshot) -> None",
        "is_stale(now_ms) -> bool"
      ],
      "role": "Voorkomt dat een oude browserweergave of ontbrekend event als actuele toestand wordt getoond."
    },
    {
      "id": "C41",
      "package": "core",
      "name": "RobotAgent",
      "file": "shared/core/agent.py",
      "attrs": [
        "mission: Mission | None",
        "executor: RouteExecutor",
        "pending: RobotCommand | None",
        "visited: list[str]",
        "last_event_seq: int"
      ],
      "ops": [
        "tick() -> None",
        "accept(command) -> str",
        "apply_pending_at_anchor() -> None",
        "emit(event) -> None"
      ],
      "role": "Gezaghebbende robotcyclus op ESP32 of in simulatie; netwerk naar uitvoerder, bezoekregistratie en resultaat."
    },
    {
      "id": "C42",
      "package": "simulation",
      "name": "InMemoryChannel",
      "file": "sim/channel.py",
      "attrs": [
        "inbox: bounded_queue",
        "peer: InMemoryChannel | None"
      ],
      "ops": [
        "receive(limit) -> list[dict]",
        "send(message) -> None",
        "connected() -> bool",
        "pair() -> tuple[InMemoryChannel, InMemoryChannel]"
      ],
      "role": "Twee verbonden kanaaleinden voor planner en gesimuleerde robot, zonder echte broker."
    }
  ],
  "enums": [
    [
      "NodeKind",
