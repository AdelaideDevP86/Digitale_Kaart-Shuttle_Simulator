stream
{
  "classes": [
    {
      "id": "C01",
      "package": "model",
      "name": "TrackMap",
      "file": "shared/model/map.py",
      "attrs": [
        "map_id: str",
        "version: str",
        "nodes: dict[str, TrackNode]",
        "edges: dict[str, TrackEdge]",
        "stations: dict[str, Station]",
        "turn_rules: list[TurnRule]",
        "metadata: dict"
      ],
      "ops": [
        "neighbors(node_id) -> list[TrackEdge]",
        "edge(edge_id) -> TrackEdge",
        "station(station_id) -> Station"
      ],
      "role": "Canonical kaart; topologie en expliciete lokale poorten, geen afslaglijst per proefrit."
    },
    {
      "id": "C02",
      "package": "model",
      "name": "TrackNode",
      "file": "shared/model/map.py",
      "attrs": [
        "node_id: str",
        "kind: NodeKind",
        "u: float; v: float",
        "ports: list[str]",
        "anchor_id: str | None"
      ],
      "ops": [
        "has_port(port) -> bool"
      ],
      "role": "Kruispunt, verplichte hoek, eindpunt of depot; coordinaten zijn schematisch."
    },
    {
      "id": "C03",
      "package": "model",
      "name": "TrackEdge",
      "file": "shared/model/map.py",
      "attrs": [
        "edge_id: str",
        "a_id: str; a_port: str",
        "b_id: str; b_port: str",
        "length_mm: float | None",
        "geometry: dict",
        "enabled: bool"
      ],
      "ops": [
        "other(node_id) -> str",
        "port_at(node_id) -> str",
        "cost(mode) -> float"
      ],
      "role": "Verbinding met lokale eindtangenten. Lengte onbekend blijft null; geen verzonnen mm."
    },
    {
      "id": "C04",
      "package": "model",
      "name": "TurnRule",
      "file": "shared/model/map.py",
      "attrs": [
        "node_id: str",
        "incoming_edge_id: str",
        "outgoing_edge_id: str",
        "maneuver: Maneuver",
        "allowed: bool"
      ],
      "ops": [
        "matches(node_id, incoming, outgoing) -> bool"
      ],
      "role": "Afslag hangt af van aankomstrichting. Ook verplichte hoeken en terminal-U-bochten zijn expliciet."
    },
    {
      "id": "C05",
      "package": "model",
      "name": "Station",
      "file": "shared/model/station.py",
      "attrs": [
        "station_id: str; name: str",
        "terminal_node_id: str",
        "service_node_id: str | None",
        "candidate_service_node_id: str | None",
        "anchor_id: str | None",
        "hardware_validated: bool"
      ],
      "ops": [
        "can_serve_on_hardware() -> bool"
      ],
      "role": "Scheidt getekend lijneinde van het werkelijk goedgekeurde aankomst-/vertrekpunt."
    },
    {
      "id": "C06",
      "package": "model",
      "name": "Mission",
      "file": "shared/model/mission.py",
      "attrs": [
        "mission_id: str; revision: int",
        "visit_ids: list[str]",
        "dwell_ms: list[int]",
        "end_node_id: str",
        "status: MissionStatus"
      ],
      "ops": [
        "validate(stations) -> list[str]",
        "next_unserved(visits) -> str | None"
      ],
      "role": "Geordende bestemmingen en verblijftijden; geen impliciet sorteren of samenvoegen."
    },
    {
      "id": "C07",
      "package": "model",
      "name": "RoutePlan",
      "file": "shared/model/plan.py",
      "attrs": [
        "plan_id: str; plan_hash: str",
        "mission_id: str; revision: int",
        "map_version: str",
        "start_pose: RobotPose",
        "steps: list[RouteStep]"
      ],
      "ops": [
        "validate(track_map) -> list[str]",
        "remaining(step_index) -> list[RouteStep]"
      ],
      "role": "Versiegebonden uitvoerplan; inclusief verwachte aankomst, service en eindactie."
    },
    {
      "id": "C08",
      "package": "model",
      "name": "RouteStep",
      "file": "shared/model/plan.py",
      "attrs": [
        "step_id: str; index: int",
        "from_id: str; to_id: str",
        "edge_id: str | None",
        "maneuver: Maneuver",
        "station_id: str | None",
        "dwell_ms: int; evidence: str"
      ],
      "ops": [
        "requires_anchor() -> bool"
      ],
      "role": "Edge-stap met STRAIGHT/LEFT/RIGHT/U_TURN, of SERVICE/END; hoeken worden niet stilzwijgend weggelaten."
    },
    {
      "id": "C09",
      "package": "model",
      "name": "RobotPose",
      "file": "shared/model/pose.py",
      "attrs": [
        "last_node_id: str | None",
        "incoming_edge_id: str | None",
        "current_edge_id: str | None",
        "confidence: PoseConfidence",
        "observation_seq: int"
      ],
      "ops": [
        "is_anchored() -> bool",
        "copy() -> RobotPose"
      ],
      "role": "Operationele plaatsinschatting; verwachte positie wordt nooit als gemeten waarheid gepresenteerd."
    },
    {
      "id": "C10",
      "package": "model",
      "name": "SensorFrame",
      "file": "shared/model/observations.py",
      "attrs": [
        "sample_seq: int; time_ms: int",
        "bits: str[5]",
        "distance_mm: float | None",
        "anchor_id: str | None"
      ],
      "ops": [
        "validate() -> bool"
      ],
      "role": "Ruwe genormaliseerde meting; precies vijf lijnsensorbits, zwart=1."
    },
    {
      "id": "C11",
      "package": "model",
      "name": "TrackObservation",
      "file": "shared/model/observations.py",
      "attrs": [
        "observation_seq: int; time_ms: int",
        "kind: str",
        "pattern: str[5]",
        "seen_branches: list[str]",
        "anchor_id: str | None",
        "stable_ms: int"
      ],
      "ops": [
        "compatible(step, track_map) -> bool"
      ],
      "role": "Gefilterde waarneming; compatibiliteit is geen unieke plaatsbepaling zonder anker."
    },
    {
      "id": "C12",
      "package": "model",
      "name": "RobotCommand",
      "file": "shared/model/messages.py",
      "attrs": [
        "schema_version: int; command_id: str",
        "robot_id: str; session_id: str; source: str",
        "kind: CommandKind",
        "mission_id: str; revision: int; map_version: str",
        "issued_at: str; expires_at: str",
        "valid_from_node: str | None",
        "payload: dict"
      ],
      "ops": [
        "validate_shape() -> list[str]"
      ],
      "role": "Gevalideerde opdracht met ID, revisie, geldigheid en bekende toepassingsgrens."
    },
    {
      "id": "C13",
      "package": "model",
      "name": "RobotEvent",
      "file": "shared/model/messages.py",
      "attrs": [
        "schema_version: int; event_id: str; event_seq: int",
        "robot_id: str; session_id: str; source: str",
        "mission_id: str | None; revision: int",
        "map_version: str; plan_hash: str | None",
        "event_kind: str; state: ExecutorState",
        "step_id: str | None; pose: RobotPose",
        "time_ms: int; time_utc: str | None",
        "observation_seq: int; payload: dict"
      ],
      "ops": [
        "to_dict() -> dict"
      ],
      "role": "Status/voortgang/resultaat met bron simulation of hardware; geen impliciete MQTT-ACK als ritsucces."
    },
    {
      "id": "C14",
      "package": "core",
      "name": "GraphValidator",
      "file": "shared/core/validation.py",
      "attrs": [],
      "ops": [
        "validate_map(track_map) -> list[str]",
        "validate_service_points(track_map, hardware) -> list[str]"
      ],
      "role": "Controleert IDs, verbindingen, poorten, verboden overgangen en oningevulde fysieke servicepunten."
    },
    {
      "id": "C15",
      "package": "core",
      "name": "RoutePlanner",
      "file": "shared/core/planner.py",
      "attrs": [
        "track_map: TrackMap"
      ],
      "ops": [
        "plan(mission, pose, cost_mode) -> RoutePlan",
        "path(start_pose, target_id, cost_mode) -> list[RouteStep]"
      ],
      "role": "Dijkstra op toestand (knoop, inkomende edge), met deterministische gelijke-kostenkeuze."
    },
    {
      "id": "C16",
      "package": "core",
      "name": "CommandValidator",
      "file": "shared/core/commands.py",
      "attrs": [
        "recent_ids: bounded_set",
        "active_revision: int"
      ],
      "ops": [
        "check(command, pose, map_version, transport_meta) -> str",
        "remember(command_id) -> None"
      ],
      "role": "Controleert vorm, duplicaten, revisies en voorwaarden; firmware gebruikt compacte contractvalidatie."
    },
    {
      "id": "C17",
      "package": "core",
      "name": "MissionCoordinator",
      "file": "shared/core/coordinator.py",
      "attrs": [
        "active: Mission | None",
        "pending: RobotCommand | None",
        "visited: list[str]",
        "request_ids: bounded_map"
      ],
      "ops": [
        "submit(mission, pose, request_id) -> RobotCommand",
        "replace(mission, boundary) -> RobotCommand",
        "on_event(event) -> None",
        "result_consistent(event) -> bool",
        "restore(events) -> None"
      ],
      "role": "Server: gewenste missie plannen en gevalideerde robotresultaten spiegelen; bestuurt geen motoren."
    },
    {
      "id": "C18",
      "package": "core",
      "name": "PoseEstimator",
      "file": "shared/core/localization.py",
      "attrs": [
        "pose: RobotPose",
        "expected_step: RouteStep | None"
      ],
      "ops": [
        "update(observation) -> RobotPose",
        "anchor(node_id, anchor_id) -> RobotPose",
        "invalidate(reason) -> None"
      ],
      "role": "Beheert onzekerheid; gemiste/dubbele punten mogen geen fictieve bevestigde locatie worden."
    },
    {
      "id": "C19",
      "package": "core",
      "name": "JunctionDetector",
      "file": "shared/core/detector.py",
      "attrs": [
        "armed: bool",
        "candidate_since_ms: int | None",
        "last_observation_seq: int",
        "thresholds_ms: dict"
      ],
      "ops": [
        "update(frame) -> TrackObservation | None",
        "confirm_exit(observation) -> None",
        "reset() -> None"
      ],
      "role": "Debounce en precies-een-punt-per-passage; een bevestigde lijn niet nogmaals blokkeren."
    },
    {
      "id": "C20",
      "package": "core",
      "name": "LineController",
      "file": "shared/core/line_control.py",
      "attrs": [
        "kp: float; ki: float; kd: float",
        "integral: float",
        "history: bounded_list",
        "base_pwm: float"
      ],
      "ops": [
        "update(frame, dt_ms) -> tuple[float,float]",
        "reset() -> None"
      ],
      "role": "Tijdgebaseerde PID met begrensde uitgangen; geen routekeuzes of netwerk-I/O."
    },
    {
      "id": "C21",
      "package": "core",
      "name": "RouteExecutor",
      "file": "shared/core/executor.py",
      "attrs": [
        "state: ExecutorState",
        "resume_state: ExecutorState | None",
        "plan: RoutePlan | None",
        "step_index: int",
        "pending_events: bounded_queue"
      ],
      "ops": [
        "tick(now_ms, frame, observation) -> None",
        "install(plan) -> None",
        "pause(reason) -> None",
        "resume() -> None",
        "drain_events() -> list[RobotEvent]"
      ],
      "role": "Niet-blokkerende uitvoering: lijnvolgen, bocht, service, zoeken en einde; motorbesturing via port."
    },
    {
      "id": "C22",
      "package": "ports",
      "name": "Clock",
      "file": "shared/ports.py",
      "attrs": [],
      "ops": [
        "now_ms() -> int",
        "diff_ms(a,b) -> int"
      ],
      "role": "Interface voor monotone tijd, inclusief ticks-wrap op ESP32."
    },
    {
      "id": "C23",
      "package": "ports",
      "name": "HardwareIO",
      "file": "shared/ports.py",
      "attrs": [],
      "ops": [
        "read_frame() -> SensorFrame",
        "set_motors(left,right) -> None",
        "stop() -> None"
      ],
      "role": "Interface voor sensoren en motoren; uitvoerder kent geen GPIO-pinnen."
    },
    {
      "id": "C24",
      "package": "ports",
      "name": "MessageChannel",
      "file": "shared/ports.py",
      "attrs": [],
      "ops": [
        "receive(limit) -> list[dict]",
        "send(message) -> None",
        "connected() -> bool"
      ],
      "role": "Bidirectionele interface met begrensde verwerking; richting/type wordt aan de grens gevalideerd."
    },
    {
      "id": "C25",
      "package": "ports",
      "name": "EventSink",
      "file": "shared/ports.py",
      "attrs": [],
      "ops": [
        "append(event) -> None",
        "checkpoint() -> None"
      ],
      "role": "Interface voor journal en replay; kritieke gebeurtenissen niet stilzwijgend verliezen."
    },
    {
      "id": "C26",
      "package": "adapters",
      "name": "SystemClock",
      "file": "server/adapters/clock.py",
      "attrs": [],
      "ops": [
        "now_ms() -> int",
        "diff_ms(a,b) -> int"
      ],
      "role": "CPython monotone tijd."
    },
    {
      "id": "C27",
      "package": "adapters",
      "name": "FakeClock",
      "file": "sim/clock.py",
      "attrs": [
        "time_ms: int"
      ],
      "ops": [
        "now_ms() -> int",
        "diff_ms(a,b) -> int",
        "advance(dt_ms) -> None"
      ],
      "role": "Deterministische simulatietijd, onafhankelijk van browser-FPS."
    },
    {
      "id": "C28",
      "package": "adapters",
      "name": "Esp32Clock",
      "file": "firmware/adapters/clock.py",
      "attrs": [],
      "ops": [
        "now_ms() -> int",
        "diff_ms(a,b) -> int"
      ],
      "role": "MicroPython ticks_ms/ticks_diff-adapter."
    },
    {
      "id": "C29",
      "package": "adapters",
      "name": "Esp32Hardware",
      "file": "firmware/adapters/hardware.py",
      "attrs": [
        "pin_config: dict",
        "calibration: dict"
      ],
      "ops": [
        "read_frame() -> SensorFrame",
        "set_motors(left,right) -> None",
        "stop() -> None"
      ],
      "role": "Normaliseert vijf sensoren, PWM, motorpolariteit en optionele afstand-/ankermeting."
    },
    {
      "id": "C30",
      "package": "adapters",
      "name": "MqttGateway",
      "file": "server/adapters/mqtt_gateway.py",
      "attrs": [
        "inbox: bounded_queue",
        "outbox: bounded_queue"
      ],
      "ops": [
        "receive(limit) -> list[dict]",
        "send(message) -> None",
        "connected() -> bool"
      ],
      "role": "Paho-client in I/O-worker; brokercallbacks zetten alleen berichten in een queue."
    },
    {
      "id": "C31",
      "package": "adapters",
      "name": "FirmwareMqttChannel",
      "file": "firmware/adapters/mqtt_channel.py",
      "attrs": [
        "inbox: bounded_queue",
        "outbox: bounded_queue",
        "session_id: str"
      ],
      "ops": [
        "receive(limit) -> list[dict]",
        "send(message) -> None",
        "connected() -> bool"
      ],
      "role": "ESP32 MQTT-adapter; concrete client/polling moet eerst op blokkering en budget getest worden."
    },
    {
      "id": "C32",
      "package": "simulation",
      "name": "SimHardware",
      "file": "sim/hardware.py",
      "attrs": [
        "mode: str",
        "true_pose: dict",
        "motor_command: tuple",
        "sensor_script: list",
        "seed: int"
      ],
      "ops": [
        "read_frame() -> SensorFrame",
        "set_motors(left,right) -> None",
        "stop() -> None",
        "advance(dt_ms) -> None"
      ],
      "role": "Implementeert HardwareIO. Ground truth blijft verborgen voor de uitvoerder."
    },
    {
      "id": "C33",
      "package": "simulation",
      "name": "FaultInjector",
      "file": "sim/faults.py",
      "attrs": [
        "seed: int",
        "schedule: list[dict]"
      ],
      "ops": [
        "transform_frame(frame) -> SensorFrame",
        "transform_command(command) -> list[RobotCommand]"
      ],
      "role": "Herhaalbare ruis, gemiste punten, dubbele berichten en disconnects."
    },
    {
      "id": "C34",
      "package": "simulation",
      "name": "SimulationEngine",
      "file": "sim/engine.py",
      "attrs": [
        "clock: FakeClock",
        "hardware: SimHardware",
        "agent: RobotAgent",
        "tick_ms: int"
      ],
      "ops": [
        "step() -> list[RobotEvent]",
        "run_until(predicate, max_ticks) -> list[RobotEvent]",
        "reset(scenario) -> None"
      ],
      "role": "Een eigenaar van simulatietoestand; bounded test-run is iets anders dan robotzoektijd."
    },
    {
      "id": "C35",
      "package": "simulation",
      "name": "EventJournal",
      "file": "shared/journal.py",
      "attrs": [
        "run_id: str",
        "path: str",
        "last_event_seq: int"
      ],
      "ops": [
        "append(event) -> None",
        "checkpoint() -> None",
        "read(run_id) -> list[RobotEvent]"
      ],
      "role": "Begrensd RAM-journal; server schrijft via worker, firmware checkpoint alleen buiten beweging. JSONL met versies/seed."
    },
    {
      "id": "C36",
      "package": "simulation",
      "name": "ReplayRunner",
      "file": "sim/replay.py",
      "attrs": [],
      "ops": [
        "run(recording, config) -> list[RobotEvent]",
        "compare(expected,actual) -> list[str]"
      ],
      "role": "Herspeelt ruwe frames en opdrachten op FakeClock; een eventlog alleen herspeelt geen sensoren."
    },
    {
      "id": "C37",
      "package": "application",
      "name": "ApiService",
      "file": "server/api.py",
      "attrs": [
        "planner: RoutePlanner",
