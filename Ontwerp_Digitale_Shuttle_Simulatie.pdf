      ],
      "role": "HTTP/WebSocket-grens, validatie en expliciete keuze simulation versus hardware."
    },
    {
      "id": "C38",
      "package": "application",
      "name": "BrowserClient",
      "file": "web/client.js",
      "attrs": [
        "selected_mode: str",
        "session_id: str"
      ],
      "ops": [
        "submit_mission() -> None",
        "connect_events() -> None",
        "reconnect() -> None"
      ],
      "role": "Bediening; nooit directe brokercredentials of motorcommando vanuit de browser."
    },
    {
      "id": "C39",
      "package": "application",
      "name": "MapRenderer",
      "file": "web/map_renderer.js",
      "attrs": [
        "map_version: str",
        "svg_root: element"
      ],
      "ops": [
        "draw_map(map) -> None",
        "draw_plan(plan) -> None",
        "draw_pose(pose) -> None"
      ],
      "role": "SVG-kaart, richtingpijl, verwachte/zekere positie en punten met onbekende kalibratie."
    },
    {
      "id": "C40",
      "package": "application",
      "name": "TelemetryStore",
